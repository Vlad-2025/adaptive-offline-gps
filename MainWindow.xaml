<Window x:Class="adaptive_offline_gps.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:ui="clr-namespace:adaptive_offline_gps.UI"
        Title="Adaptive Offline GPS"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1100"
        Background="#0D0D0F"
        FontFamily="Consolas">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <ui:TopBar x:Name="TopBar" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="420"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ui:LeftPanel x:Name="LeftPanel" Grid.Column="0"/>

            <GridSplitter Grid.Column="1"
                          Width="4" HorizontalAlignment="Stretch"
                          Background="#1A1A24" ShowsPreview="False" Cursor="SizeWE"/>

            <Grid Grid.Column="2" Background="#0D0D0F">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="140"/>
                </Grid.RowDefinitions>

                <!-- Map container — only one of MapContainer / DownloadPanel visible -->
                <Border Grid.Row="0" x:Name="MapContainer"
                        Background="#0D0D0F"
                        SizeChanged="MapContainer_SizeChanged"
                        Visibility="Collapsed">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="MapBorder"
                                BorderBrush="#2A2A3D" BorderThickness="1"
                                CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <mapsui:MapControl x:Name="mapControl"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Stretch"/>
                                <!-- Canvas with no background = transparent to hits on empty area.
                                     Popup child re-enables hit testing for its own buttons. -->
                                <Canvas x:Name="MapOverlayCanvas">
                                    <ui:MapClickPopup x:Name="MapPopup" Panel.ZIndex="10"/>
                                    <!-- Dismiss overlay: sized + shown in code when popup opens -->
                                    <Rectangle x:Name="PopupDismissOverlay"
                                               Fill="Transparent"
                                               Visibility="Collapsed"
                                               Panel.ZIndex="9"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <Border x:Name="LoadingOverlay"
                            Visibility="Collapsed"
                            Background="#CC0D0D0F"
                            Grid.Row="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLoadingStatus"
                                       Text="loading..."
                                       Foreground="#00FF88" FontFamily="Consolas" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <ProgressBar x:Name="LoadingProgress"
                                         Width="300" Height="4"
                                         IsIndeterminate="True"
                                         Foreground="#00FF88" Background="#1A1A24"
                                         BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ui:DownloadPanel x:Name="DownloadPanel"
                                  Grid.Row="0"
                                  Visibility="Visible"/>

                <GridSplitter Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch"
                              Background="#1A1A24" Cursor="SizeNS"/>

                <ui:RouteInfoPanel x:Name="RouteInfoPanel" Grid.Row="2"/>
            </Grid>
        </Grid>

        <ui:BottomBar x:Name="BottomBar" Grid.Row="2"/>
    </Grid>
</Window>

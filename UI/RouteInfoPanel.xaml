<UserControl x:Class="adaptive_offline_gps.UI.RouteInfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#13131A"
            BorderBrush="#2A2A3D"
            BorderThickness="0,1,0,0"
            Padding="16,10">
        <StackPanel>
            <TextBlock Text="// ROUTE INFO" Foreground="#3A3A5C"
                       FontSize="9" FontFamily="Consolas" Margin="0,0,0,8"/>

            <!-- Pin selection row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <!-- Start -->
                <Ellipse Width="8" Height="8" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#00DC64"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="start  " Style="{StaticResource StatusLabel}"/>
                <TextBlock x:Name="TxtStart" Text="—" Style="{StaticResource StatusValue}"/>

                <!-- End -->
                <Ellipse Width="8" Height="8" Margin="8,0,5,0" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="#FF3C50"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="dest  " Style="{StaticResource StatusLabel}"/>
                <TextBlock x:Name="TxtEnd" Text="—" Style="{StaticResource StatusValue}"/>
            </StackPanel>

            <!-- Route metrics row -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="distance  " Style="{StaticResource StatusLabel}"/>
                <TextBlock x:Name="TxtDistance" Text="—" Style="{StaticResource StatusValue}"/>
                <TextBlock Text="est. time  " Style="{StaticResource StatusLabel}"/>
                <TextBlock x:Name="TxtTime"     Text="—" Style="{StaticResource StatusValue}"/>
                <TextBlock Text="nodes visited  " Style="{StaticResource StatusLabel}"/>
                <TextBlock x:Name="TxtNodes"    Text="—" Style="{StaticResource StatusValue}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

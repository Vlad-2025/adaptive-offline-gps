<Window x:Class="adaptive_offline_gps.UI.BookmarkNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="bookmark"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0D0D0F"
        FontFamily="Consolas">

    <Border Background="#0D0D0F" BorderBrush="#2A2A3D" BorderThickness="1" Padding="20">
        <StackPanel>

            <TextBlock x:Name="TxtHeader"
                       Text="// NEW BOOKMARK"
                       Foreground="#8888BB" FontFamily="Consolas" FontSize="13"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtCoords"
                       Text=""
                       Foreground="#3A3A5C" FontFamily="Consolas" FontSize="10"
                       Margin="0,0,0,12"/>

            <TextBlock Text="name"
                       Foreground="#3A3A5C" FontFamily="Consolas" FontSize="10"
                       Margin="0,0,0,4"/>

            <TextBox x:Name="TxtName"
                     Background="#1F1F2E" Foreground="#8888BB"
                     BorderBrush="#2A2A3D" BorderThickness="1"
                     FontFamily="Consolas" FontSize="12"
                     Padding="6,4"
                     Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="[ CANCEL ]"
                        Style="{StaticResource TopBarButton}"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk"
                        Content="[ OK ]"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

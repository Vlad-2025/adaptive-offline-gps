<UserControl x:Class="adaptive_offline_gps.UI.DebugConsole"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- Header row with clear button -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <TextBlock Style="{StaticResource SectionHeader}" Text="// DEBUG CONSOLE" Margin="0"/>
            <TextBlock Text=" - " Foreground="#2A2A3D" FontSize="9" FontFamily="Consolas"
                       VerticalAlignment="Bottom" Margin="4,0,0,6"/>
            <Button x:Name="BtnClear" Content="clear"
                    Background="Transparent" Foreground="#3A3A5C"
                    BorderThickness="0" FontSize="9" FontFamily="Consolas"
                    Cursor="Hand" VerticalAlignment="Bottom" Margin="0,0,0,6"
                    Click="BtnClear_Click"/>
        </StackPanel>

        <!-- Log output -->
        <Border Background="#0D0D0F" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="4" Height="220">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="8,6">
                <StackPanel x:Name="LogPanel"/>
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>

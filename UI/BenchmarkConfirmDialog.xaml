<Window x:Class="adaptive_offline_gps.UI.BenchmarkConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="run benchmark"
        Height="220" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#0D0D0F"
        FontFamily="Consolas">

    <Border Background="#13131A"
            BorderBrush="#2A2A3D"
            BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="// CONFIRM BENCHMARK"
                       Foreground="#8888BB" FontFamily="Consolas" FontSize="13"
                       Margin="0,0,0,12"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="this benchmark may take a while depending on graph size and algorithm choice."
                           Foreground="#8888BB" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtEstimateLine"
                           Text=""
                           Foreground="#4488FF" FontFamily="Consolas" FontSize="11"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="visualization is disabled during the run."
                           Foreground="#3A3A5C" FontFamily="Consolas" FontSize="10"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button x:Name="BtnCancel"
                        Content="[ CANCEL ]"
                        Style="{StaticResource TopBarButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnConfirm"
                        Content="[ RUN ]"
                        Style="{StaticResource AccentButton}"
                        IsDefault="True"
                        Click="BtnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

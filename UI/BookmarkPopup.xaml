<UserControl x:Class="adaptive_offline_gps.UI.BookmarkPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             IsHitTestVisible="True">

    <Border Background="#13131A"
            BorderBrush="#2A2A3D"
            BorderThickness="1"
            CornerRadius="4"
            Padding="0"
            Width="180"
            Effect="{x:Null}">
        <StackPanel>

            <!-- Header: name + coords -->
            <Border Background="#1A1A24" CornerRadius="4,4,0,0" Padding="10,7">
                <StackPanel>
                    <TextBlock x:Name="TxtName"
                               Text="bookmark"
                               Foreground="#4488FF" FontFamily="Consolas" FontSize="11"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtCoords"
                               Text="45.0000, 25.0000"
                               Foreground="#3A3A5C" FontFamily="Consolas" FontSize="9"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Margin="0,2,0,2">
                <Button x:Name="BtnSetStart"
                        Content="[ SET AS START ]"
                        Style="{StaticResource TopBarButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="4,2" Padding="8,5"
                        Click="BtnSetStart_Click"/>

                <Button x:Name="BtnSetEnd"
                        Content="[ SET AS DESTINATION ]"
                        Style="{StaticResource TopBarButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="4,2" Padding="8,5"
                        Click="BtnSetEnd_Click"/>

                <Separator Background="#2A2A3D" Margin="8,4"/>

                <Button x:Name="BtnRename"
                        Content="[ RENAME ]"
                        Style="{StaticResource TopBarButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="4,2" Padding="8,5"
                        Click="BtnRename_Click"/>

                <Button x:Name="BtnDelete"
                        Content="[ DELETE ]"
                        Style="{StaticResource TopBarButton}"
                        Foreground="#FF4455"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="4,2" Padding="8,5"
                        Click="BtnDelete_Click"/>

                <Separator Background="#2A2A3D" Margin="8,4"/>

                <Button x:Name="BtnDismiss"
                        Content="dismiss"
                        Background="Transparent" Foreground="#3A3A5C"
                        BorderThickness="0" FontSize="9" FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Cursor="Hand" Margin="12,2,4,6" Padding="0"
                        Click="BtnDismiss_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
